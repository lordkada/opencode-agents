{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "./.agents/skills"
  ],
  "instructions": [
    "instructions/workspace-shared.md"
  ],
  "mcp": {
    "servers": {
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp"
      }
    }
  },
  "commands": {
    "setup-env": {
      "description": "Configura e testa passo-passo le credenziali del workspace (.env) e il server MCP Atlassian",
      "template": "Carica la skill @setup-workspace-env ed esegui la verifica iniziale dello stato del file .env (creandolo da .env.template se necessario) e del server MCP Atlassian, poi guidami passo-passo nella configurazione e nel test delle credenziali mancanti."
    }
  }
}

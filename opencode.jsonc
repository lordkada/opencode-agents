{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "./.agents/skills"
  ],
  "instructions": [
    "instructions/workspace-shared.md"
  ],
  "commands": {
    "setup-env": {
      "description": "Configura e testa passo-passo le credenziali del workspace (.env) per Slack, Gmail e Fellow",
      "template": "Carica la skill @setup-workspace-env ed esegui la verifica iniziale dello stato del file .env (creandolo da .env.template se necessario), poi guidami passo-passo nella configurazione e nel test delle credenziali mancanti."
    }
  }
}

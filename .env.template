# ==============================================================================
# Credenziali Workspace per OpenCode
# ==============================================================================
# Copia questo file in `.env` (nella root del progetto o in ~/.config/opencode/.env)
# e compila i valori reali, oppure chiedi a OpenCode di guidarti usando la skill
# `@setup-workspace-env`.
#
# ATTENZIONE: Non committare MAI il file `.env` con le credenziali reali!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Slack - usati dalla skill `slack-connector`
# ------------------------------------------------------------------------------
# Token di sessione client (inizia con xoxc-...) estratto da localStorage.localConfig_v2 su app.slack.com
SLACK_XOXC_TOKEN="xoxc-inserisci-qui-il-tuo-token"

# Cookie di sessione 'd' (inizia con xoxd-...) estratto dai cookie di https://app.slack.com
SLACK_XOXD_COOKIE="xoxd-inserisci-qui-il-tuo-cookie"

# ------------------------------------------------------------------------------
# 2. Gmail Google Workspace (IMAP sola lettura) - usati dalla skill `gmail-imap`
# ------------------------------------------------------------------------------
# Indirizzo email Google Workspace
GMAIL_USER="nome.cognome@example.com"

# Password per le app di Google (16 caratteri) generata su https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# ------------------------------------------------------------------------------
# 3. Fellow (Meeting Notes & Action Items) - usati dalla skill `fellow-notes`
# ------------------------------------------------------------------------------
# Sottodominio Fellow del tuo workspace (es. "mio-team" per https://mio-team.fellow.app)
FELLOW_SUBDOMAIN="inserisci-qui-il-sottodominio"

# Personal API Key generata da https://<sottodominio>.fellow.app (User Settings -> Developer / API Keys)
FELLOW_API_TOKEN="inserisci-qui-il-tuo-token-fellow"

# ------------------------------------------------------------------------------
# 4. Atlassian MCP Server (https://mcp.atlassian.com/v2/mcp) - OPZIONALE
# ------------------------------------------------------------------------------
# NOTA: Di default il server MCP Atlassian usa OAuth 2.1 interattivo (tramite `/mcps`
# in OpenCode) e NON richiede variabili nel file .env.
# Compila i campi seguenti SOLO se usi l'autenticazione alternativa via Personal API Token
# (Basic Auth) in ambienti containerizzati/headless con `"oauth": false` in opencode.jsonc.
# Guida: https://support.atlassian.com/atlassian-ai-gateway/docs/configure-authentication-via-api-token/
#
# Stringa Base64 calcolata da `echo -n "nome.cognome@example.com:IL_TUO_API_TOKEN" | base64`
ATLASSIAN_MCP_BASIC_AUTH="inserisci-qui-base64-email-e-token"
